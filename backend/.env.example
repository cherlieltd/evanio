# Server
PORT=8080
NODE_ENV=development

# CORS — local defaults match package.json ports
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# Supabase (server-side secrets — never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_CREDITS_BOOST=price_...
STRIPE_PRICE_CREDITS_GROWTH=price_...
STRIPE_PRICE_CREDITS_SCALE=price_...

# Meta (Facebook / Instagram)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=your-meta-webhook-verify-token
META_REDIRECT_URI=http://localhost:8080/meta/oauth/callback
META_GRAPH_VERSION=v22.0
API_PUBLIC_URL=http://localhost:8080
WIDGET_RATE_LIMIT_PER_MIN=30

# Encrypt social page tokens at rest (64-char hex or any passphrase)
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret-or-64-hex-chars

# AI providers (all AI calls stay in the backend)
OPENAI_API_KEY=sk-...
OPENAI_EVI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_VIDEO_MODEL=sora-2
ANTHROPIC_API_KEY=sk-ant-...

# Email (Brevo) — optional locally; skipped if BREVO_API_KEY is unset
# Create key: Brevo → Settings → SMTP & API → API keys
BREVO_API_KEY=xkeysib-...
EMAIL_FROM_NOREPLY="Evanio.ai <noreply@evanio.ai>"
EMAIL_FROM_NOTIFICATIONS="Evanio.ai <notifications@evanio.ai>"
EMAIL_FROM_BILLING="Evanio.ai Billing <billing@evanio.ai>"
EMAIL_REPLY_TO="hello@evanio.ai"

